{
    "name": "On-Demand Models",
    "id": "models",
    "version": "1.0.1",
    "description": "ON-DEMAND model fetch; weights (9-16 GB) are NEVER baked into image layers. Installs fetch-models.sh script.",
    "options": {
        "MODEL": {
            "type": "string",
            "default": "gemma-4-26B-A4B-it-UD-IQ2_M",
            "description": "Hugging Face model repo/filename identifier"
        },
        "QUANT": {
            "type": "string",
            "default": "IQ2_M",
            "description": "Quantization level for the model"
        },
        "MODELS_DIR": {
            "type": "string",
            "default": "",
            "description": "Custom directory for models; defaults to $PWD/models"
        }
    }
}