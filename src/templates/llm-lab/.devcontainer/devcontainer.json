{
    "name": "llm-lab",
    "dockerFile": "Dockerfile",
    "features": {
        "ghcr.io/nmwael/agentic-devcontainer-feature/llama-server": "1",
        "ghcr.io/nmwael/agentic-devcontainer-feature/gpu-bridge": "${templateOption:GPU_MODE == 'wsl2' ? '1' : '0'}",
        "ghcr.io/nmwael/agentic-devcontainer-feature/bifrost-gateway": "1",
        "ghcr.io/nmwael/agentic-devcontainer-feature/models": "${templateOption:INCLUDE_MODELS ? '1' : '0'}",
        "ghcr.io/nmwael/agentic-devcontainer-feature/opencode-agents": "${templateOption:INCLUDE_AGENTS ? '1' : '0'}"
    },
    "runArgs": [
        "${templateOption:GPU_MODE == 'wsl2' ? '--device=nvidia.com/gpu=all' : ''}",
        "${templateOption:GPU_MODE == 'native' ? '--device=nvidia.com/gpu=all' : ''}",
        "--shm-size=2g",
        "${templateOption:GPU_MODE != 'none' ? '--cap-add=SYS_PTRACE' : ''}",
        "${templateOption:GPU_MODE != 'none' ? '--security-opt=seccomp:unconfined' : ''}"
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                "njvtkiernen.vscode-color-preview",
                "github.vscode-github-actions"
            ]
        }
    }
}