{
    "name": "llm-lab",
    "dockerFile": "Dockerfile",
    "features": {
        "ghcr.io/nmwael/agentic-devcontainer-feature/llama-server": "${templateOption:FEATURES_TAG}",
        "ghcr.io/nmwael/agentic-devcontainer-feature/gpu-bridge": "1",
        "ghcr.io/nmwael/agentic-devcontainer-feature/bifrost-gateway": "${templateOption:FEATURES_TAG}",
        "ghcr.io/nmwael/agentic-devcontainer-feature/models": {
            "version": "${templateOption:FEATURES_TAG}",
            "MODELS": "${templateOption:MODELS}",
            "ROLES": "${templateOption:ROLES}",
            "MODEL": "${templateOption:MODEL}"
        },
        "ghcr.io/nmwael/agentic-devcontainer-feature/opencode-agents": {
            "version": "${templateOption:FEATURES_TAG}",
            "WITH_LIBRARY": "${templateOption:INCLUDE_LIBRARY}"
        },
        "ghcr.io/devcontainers-extra/features/apt-get-packages": {
            "version": "1",
            "packages": "gh,jq,shfmt"
        }
    },
    "runArgs": [
        "--shm-size=2g"
    ],
    "remoteUser": "root",
    "forwardPorts": [8082, 8089, 4096],
    "customizations": {
        "vscode": {
            "extensions": [
                "njvtkiernen.vscode-color-preview",
                "github.vscode-github-actions"
            ]
        }
    }
}